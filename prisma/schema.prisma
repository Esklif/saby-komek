generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Campaign {
  id             String   @id @default(uuid())
  campaignNumber String   @unique // e.g. #240512
  beneficiary    String   // e.g. Алимжан С.
  age            String   // e.g. 6 лет
  city           String   // e.g. г. Алматы
  category       String   // e.g. Здоровье
  diagnosis      String   // e.g. Острый лимфобластный лейкоз (ОЛЛ)
  description    String   // Story
  requiredAmount Int
  gatheredAmount Int
  openDate       DateTime @default(now())
  curator        String   @default("Фонд «Саби»")
  helpersCount   Int      @default(0)
  imageUrl       String?
  reports        Report[]
  documents      Document[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Report {
  id          String   @id @default(uuid())
  title       String
  url         String
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id])
}

model Document {
  id          String   @id @default(uuid())
  title       String
  url         String
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id])
}

model HelpRequest {
  id        String   @id @default(uuid())
  name      String
  category  String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  details   String
  createdAt DateTime @default(now())
}

model BusinessOffer {
  id          String   @id @default(uuid())
  companyName String
  offerType   String   // MONEY, GOODS, SERVICES
  details     String
  createdAt   DateTime @default(now())
}
